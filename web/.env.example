# Frontend Environment Variables (Vite)
# These are baked into the build at compile time (VITE_ prefix required).
# Copy to web/.env for local development. In Coolify, set these as build-time env vars.

# --- Required: API base URL ---
VITE_API_URL=http://localhost:8080
# Production: VITE_API_URL=https://api.courtcommand.app

# --- Required: Logto OIDC ---
# Logto OIDC issuer (the discovery endpoint is <endpoint>/.well-known/openid-configuration).
VITE_LOGTO_ENDPOINT=http://localhost:3001
# Production: VITE_LOGTO_ENDPOINT=https://logto.courtcommand.app

# Logto SPA application ID (provisioned by `make logto-seed`). Get from `.env`
# at the repo root (the seeder writes it there) or from the Logto admin UI.
VITE_LOGTO_APP_ID=

# API resource indicator (audience claim of API tokens). Must match
# LOGTO_API_RESOURCE in the backend's .env.
VITE_LOGTO_API_RESOURCE=http://localhost:8080/api
# Production: VITE_LOGTO_API_RESOURCE=https://api.courtcommand.app/api

# --- Optional ---
VITE_GOOGLE_MAPS_API_KEY=

# --- Coolify Production Values ---
# VITE_API_URL=https://api.courtcommand.app
# VITE_LOGTO_ENDPOINT=https://logto.courtcommand.app
# VITE_LOGTO_APP_ID=xs87eqgcf7t1qk2atqnot
# VITE_LOGTO_API_RESOURCE=https://api.courtcommand.app/api
# VITE_GOOGLE_MAPS_API_KEY=your-production-key
